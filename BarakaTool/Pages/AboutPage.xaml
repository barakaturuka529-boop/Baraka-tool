<Page x:Class="BarakaTool.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource DarkBackground}"
      Title="About">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="20" MaxWidth="600" HorizontalAlignment="Center">

            <!-- Logo Section -->
            <Border Background="{StaticResource SurfaceColor}" Padding="40" CornerRadius="10" BorderBrush="{StaticResource PrimaryGreen}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" TextAlignment="Center" Spacing="10">
                    <TextBlock Text="🔧" FontSize="64" TextAlignment="Center"/>
                    <TextBlock Text="BARAKA TOOL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    <TextBlock Text="V1.0" FontSize="16" Foreground="#888888"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="About This Application" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    <TextBlock Text="BARAKA TOOL is a professional device management solution designed for managing mobile devices from various manufacturers. It provides comprehensive tools for device maintenance, data management, and troubleshooting." 
                               Foreground="White" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Features -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock Text="✨ Key Features" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <StackPanel Spacing="8">
                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="🔓 Remove FRP Lock" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="Safely remove Factory Reset Protection from supported devices" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="🔄 Hard Reset & Factory Reset" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="Completely wipe device data and restore to factory settings" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="💾 Device Backup" FontWeight="Bold" Foreground="#00C853"/>
                                <TextBlock Text="Create and manage device backups safely" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="📱 Multi-Brand Support" FontWeight="Bold" Foreground="#E91E63"/>
                                <TextBlock Text="Support for Samsung, Xiaomi, Tecno, Infinix, Oppo, Vivo" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Supported Devices -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="15">
                    <TextBlock Text="📱 Supported Device Brands" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="{StaticResource PrimaryGreen}" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Samsung" Foreground="{StaticResource PrimaryGreen}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Xiaomi" Foreground="{StaticResource PrimaryBlue}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="#FF9800" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Tecno" Foreground="#FF9800" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="#FF5722" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Infinix" Foreground="#FF5722" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="#00BCD4" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Oppo" Foreground="#00BCD4" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1A1A1A" Padding="15" CornerRadius="5" BorderBrush="#E91E63" BorderThickness="1">
                            <StackPanel TextAlignment="Center" Spacing="5">
                                <TextBlock Text="Vivo" Foreground="#E91E63" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="✓ Full Support" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Info -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="15">
                    <TextBlock Text="ℹ️ System Information" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <Grid ColumnSpacing="30" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Application:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="BARAKA TOOL" Foreground="White" FontSize="11"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="1.0.0" Foreground="{StaticResource PrimaryGreen}" FontSize="11"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Platform:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows 10/11 (.NET 8)" Foreground="White" FontSize="11"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Author:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Baraka Tanzania" Foreground="{StaticResource PrimaryGreen}" FontSize="11"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Location:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Tanzania 🇹🇿" Foreground="White" FontSize="11"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="License:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Professional Edition" Foreground="#FFD700" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Contact -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10" BorderBrush="#FF9800" BorderThickness="2">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="📞 Support & Contact" FontSize="16" FontWeight="Bold" Foreground="#FF9800" TextAlignment="Center"/>
                    <TextBlock Text="WhatsApp Business Support" FontSize="12" Foreground="White" TextAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="📱 +255 782 700 859" FontSize="14" Foreground="{StaticResource PrimaryBlue}" TextAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="Available 24/7 for assistance" FontSize="11" Foreground="#888888" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Background="#1A1A1A" Padding="20" CornerRadius="10">
                <StackPanel TextAlignment="Center" Spacing="5">
                    <TextBlock Text="BARAKA TANZANIA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    <TextBlock Text="Professional Device Management Solutions" FontSize="11" Foreground="#888888"/>
                    <TextBlock Text="© 2026 All Rights Reserved" FontSize="10" Foreground="#555555" Margin="0,8,0,0"/>
                    <TextBlock Text="Making Device Management Easy & Accessible" FontSize="10" Foreground="#666666" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
