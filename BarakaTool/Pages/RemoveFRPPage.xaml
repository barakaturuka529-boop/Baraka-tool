<Page x:Class="BarakaTool.Pages.RemoveFRPPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{StaticResource DarkBackground}"
      Title="Remove FRP">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="20">

            <!-- Header -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10" BorderBrush="{StaticResource PrimaryGreen}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="🔓 Remove FRP Lock" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    <TextBlock Text="Factory Reset Protection Removal Tool" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Warning Section -->
            <Border Background="#FF5252" Opacity="0.1" Padding="20" CornerRadius="10" BorderBrush="#FF5252" BorderThickness="2">
                <StackPanel Spacing="10">
                    <TextBlock Text="⚠️ Important Warning" FontSize="13" FontWeight="Bold" Foreground="#FF5252"/>
                    <TextBlock Text="• This tool will remove FRP lock from your device
• FRP is a security feature - use only on your own devices
• Removing FRP may void your device warranty
• Ensure you have proper authorization before proceeding
• Your device will restart during the process" 
                               Foreground="White" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Device Selection -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="15">
                    <TextBlock Text="📱 Select Device Brand" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryGreen}" Foreground="White" Content="Samsung" Height="50" FontWeight="Bold" Click="SamsungFRP_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryBlue}" Foreground="White" Content="Xiaomi" Height="50" FontWeight="Bold" Click="XiaomiFRP_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" Foreground="White" Content="Tecno" Height="50" FontWeight="Bold" Click="TecnoFRP_Click"/>

                        <Button Grid.Column="0" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF5722" Foreground="White" Content="Infinix" Height="50" FontWeight="Bold" Click="InfinixFRP_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignRaisedButton}" Background="#00BCD4" Foreground="White" Content="Oppo" Height="50" FontWeight="Bold" Click="OppoFRP_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E91E63" Foreground="White" Content="Vivo" Height="50" FontWeight="Bold" Click="VivoFRP_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Instructions -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10">
                <StackPanel Spacing="15">
                    <TextBlock Text="📖 Instructions" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <StackPanel Spacing="10">
                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Step 1: Connect Device" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                                <TextBlock Text="• Connect your device to computer via USB cable
• Enable USB debugging on your device
• Accept the connection prompt on device" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Step 2: Select Brand" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="• Choose your device brand from options above
• Tool will auto-detect device model
• Confirm device information when prompted" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Step 3: Remove FRP" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="• Click 'Start FRP Removal' button
• Follow on-screen prompts
• Do not disconnect device during process
• Wait for completion message" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A1A1A" Padding="12" CornerRadius="5">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Step 4: Verify" FontWeight="Bold" Foreground="#E91E63"/>
                                <TextBlock Text="• Device will restart automatically
• FRP lock should be removed
• Device is now ready for setup" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Section -->
            <Border Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10" BorderBrush="#FF5252" BorderThickness="2">
                <StackPanel Spacing="15">
                    <TextBlock Name="SelectedDeviceText" Text="No device selected" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <StackPanel Spacing="10">
                        <Button Name="StartFRPButton"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#FF5252"
                                Foreground="White"
                                Content="🚀 Start FRP Removal"
                                Height="50"
                                FontSize="14"
                                FontWeight="Bold"
                                IsEnabled="False"
                                Click="StartFRPButton_Click"
                                Cursor="Hand"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2196F3"
                                Foreground="White"
                                Content="⚙️ Advanced Options"
                                Height="40"
                                FontSize="12"
                                FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress Section -->
            <Border Name="ProgressSection" Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10" Visibility="Collapsed">
                <StackPanel Spacing="15">
                    <TextBlock Text="Processing..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    
                    <ProgressBar Name="FRPProgressBar" Height="8" Foreground="{StaticResource PrimaryGreen}" IsIndeterminate="True" CornerRadius="4"/>
                    
                    <TextBlock Name="ProgressStatusText" Text="Initializing FRP removal process..." Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Status Section -->
            <Border Name="StatusSection" Background="{StaticResource SurfaceColor}" Padding="20" CornerRadius="10" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Name="StatusTitleText" Text="Success!" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}"/>
                    <TextBlock Name="StatusMessageText" Text="FRP has been successfully removed." Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryGreen}" Foreground="White" Content="Close" Height="40" Click="CloseStatus_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
